COMPOSE_PROJECT_NAME=absensi-rsarsy
IMAGE_TAG=latest

APP_NAME="RSARSY Presence"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
# URL dasar tautan aktivasi akun di email; token ditambahkan otomatis. Jika kosong, pakai APP_URL.
ACCOUNT_ACTIVATION_URL="${APP_URL}"
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Jakarta

# Default hanya diakses melalui localhost. Atur 0.0.0.0 jika HTTP perlu dipublikasi.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
APP_HTTPS=off
NGINX_HOST=localhost
# Untuk reverse proxy di host, isi IP/CIDR proxy yang terlihat oleh container.
NGINX_TRUSTED_PROXY_CIDR=127.0.0.1
HTTPS_BIND_ADDRESS=0.0.0.0
HTTPS_PORT=443

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=absensi_rsarsy
DB_USERNAME=absensi
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_DOMAIN=null
CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=90
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

LOG_CHANNEL=stderr
LOG_LEVEL=warning

MOBILE_CORS_ALLOWED_ORIGINS=capacitor://localhost,http://localhost,https://localhost
MOBILE_ANDROID_APK_URL=

WEBPUSH_VAPID_SUBJECT=mailto:admin@example.com
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
# Letakkan credential di storage/app/private/push dan gunakan path container.
FCM_CREDENTIALS=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY_PATH=
APNS_TOPIC=id.rsarsy.presensi
APNS_SANDBOX=false

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=admin@example.com
MAIL_FROM_NAME="${APP_NAME}"

FACE_VERIFICATION_DRIVER=fastapi
FACE_SERVICE_URL=http://face-verification:8001
FACE_SERVICE_TOKEN=
FACE_SERVICE_CONNECT_TIMEOUT=3
FACE_SERVICE_TIMEOUT=45
FACE_SERVICE_MODEL_NAME=Facenet512
FACE_SERVICE_DETECTOR_BACKEND=opencv
FACE_SERVICE_DISTANCE_METRIC=cosine
FACE_SERVICE_MIN_SIMILARITY=70
FACE_SERVICE_ANTI_SPOOFING=true
FACE_SERVICE_MAX_UPLOAD_BYTES=5242880
FACE_SERVICE_MIN_IMAGE_DIMENSION=160
FACE_SERVICE_MAX_IMAGE_DIMENSION=6000
FACE_SERVICE_INFERENCE_MAX_DIMENSION=1280
FACE_SERVICE_PROFILE_EMBEDDING_CACHE_SIZE=512
FACE_SERVICE_WARMUP=true

ATTENDANCE_REQUIRE_TRUSTED_NETWORK=false
ATTENDANCE_TRUSTED_NETWORKS=
ATTENDANCE_LOCATION_PROOF_TTL=600
ATTENDANCE_LOCATION_SAMPLE_FRESHNESS=300
ATTENDANCE_LOCATION_MAX_ACCURACY=100
ATTENDANCE_LOCATION_MAX_SPEED=80

HOLIDAY_API_URL=https://indonesian-holidays.ahrulsyamil.com
HOLIDAY_AUTO_SYNC=true
VITE_APP_NAME="${APP_NAME}"
