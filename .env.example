APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
MOBILE_CORS_ALLOWED_ORIGINS=capacitor://localhost,http://localhost,https://localhost,http://localhost:5174

APP_LOCALE=en
APP_TIMEZONE=Asia/Jakarta
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

WEBPUSH_VAPID_SUBJECT=mailto:admin@example.com
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=

# Native push: server-only credential file paths, never put them in VITE_* variables.
FCM_CREDENTIALS=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY_PATH=
APNS_TOPIC=id.rsarsy.presensi
APNS_SANDBOX=false

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

FACE_VERIFICATION_DRIVER=fastapi
FACE_SERVICE_URL=http://127.0.0.1:8001
FACE_SERVICE_TOKEN=5f2676ee917b7dc4840d8879d18587602b4470a88e1845ae684c834df22e4e59
FACE_SERVICE_CONNECT_TIMEOUT=3
FACE_SERVICE_TIMEOUT=45 
FACE_SERVICE_MODEL_NAME=Facenet512
FACE_SERVICE_DETECTOR_BACKEND=opencv
FACE_SERVICE_DISTANCE_METRIC=cosine
# FACE_SERVICE_DISTANCE_THRESHOLD=0.30
FACE_SERVICE_MIN_SIMILARITY=70
FACE_SERVICE_ANTI_SPOOFING=true
FACE_SERVICE_MAX_UPLOAD_BYTES=5242880
FACE_SERVICE_MIN_IMAGE_DIMENSION=160
FACE_SERVICE_MAX_IMAGE_DIMENSION=6000
FACE_SERVICE_INFERENCE_MAX_DIMENSION=1280
FACE_SERVICE_PROFILE_EMBEDDING_CACHE_SIZE=512
FACE_SERVICE_WARMUP=true

# Proteksi lokasi presensi. Untuk keamanan produksi, aktifkan pembatasan jaringan
# dan isi IP/CIDR jaringan rumah sakit yang terlihat oleh server (pisahkan dengan koma).
ATTENDANCE_REQUIRE_TRUSTED_NETWORK=false
ATTENDANCE_TRUSTED_NETWORKS=
ATTENDANCE_LOCATION_PROOF_TTL=600
ATTENDANCE_LOCATION_SAMPLE_FRESHNESS=300
ATTENDANCE_LOCATION_MAX_ACCURACY=100
ATTENDANCE_LOCATION_MAX_SPEED=80

VITE_APP_NAME="${APP_NAME}"
