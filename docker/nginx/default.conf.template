server {
    listen 80;
    server_name ${NGINX_HOST};
    root /var/www/html/public;
    index index.php;
    server_tokens off;
    client_max_body_size 110m;

    # Only this explicit proxy is allowed to provide the original client IP.
    set_real_ip_from ${NGINX_TRUSTED_PROXY_CIDR};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location /app/ {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $reverb_upstream reverb:8080;
        proxy_pass http://$reverb_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $http_host;
        proxy_read_timeout 75s;
        proxy_send_timeout 75s;
    }

    location /build/assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt { access_log off; log_not_found off; }

    location = /index.php {
        internal;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_param HTTP_PROXY "";
        # Explicit setting supports TLS termination at a host reverse proxy.
        fastcgi_param HTTPS ${APP_HTTPS};
        fastcgi_read_timeout 120s;
        fastcgi_hide_header X-Powered-By;
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $php_upstream app:9000;
        fastcgi_pass $php_upstream;
    }

    location ~ \.php(?:/|$) { return 404; }
    location ~ /\.(?!well-known(?:/|$)) { deny all; }
}
